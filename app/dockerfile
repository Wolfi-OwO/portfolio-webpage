# Stage 1: Setup Express backend
FROM node:22-alpine AS backend
WORKDIR /app

# Upgrade base packages to get latest security fixes
RUN apk upgrade --no-cache

# Install server dependencies first (better caching)
COPY package*.json ./
RUN npm ci --omit=dev --only=production

# Copy backend source code
COPY server.js ./
COPY database/ ./database/
COPY handlers/ ./handlers/
COPY middlewares/ ./middlewares/
COPY models/ ./models/
COPY routes/ ./routes/
COPY utils/ ./utils/

# Copy only necessary backend files
COPY . .

# Build metadata (OCI image annotations) - passed in via --build-arg.
ARG VERSION=dev
ARG BUILD_DATE
ARG VCS_REF
ARG VCS_URL

LABEL org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.source="${VCS_URL}" \
    org.opencontainers.image.title="Portfolio Webpage" \
    org.opencontainers.image.description="Personal developer portfolio built with React, Express and MongoDB"

# Mirror the metadata into runtime env vars so /api/info can surface it in the footer
# (LABELs are not readable by the running process).
ENV APP_VERSION=${VERSION}
ENV APP_BUILD_DATE=${BUILD_DATE}
ENV APP_REVISION=${VCS_REF}
ENV APP_REPOSITORY_URL=${VCS_URL}

# Set production mode
ENV NODE_ENV=production
ENV PORT=8080
ENV BINDADDRESS=0.0.0.0

# Set user to node -> no admin user needed
USER node

# Expose port
EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD node utils/health-checks.js || exit 1

# Graceful shutdown signal
STOPSIGNAL SIGINT

# Start Express
CMD ["node", "server.js"]