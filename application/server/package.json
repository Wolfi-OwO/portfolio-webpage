{
  "name": "@portfolio/server",
  "version": "6.1.1",
  "description": "Personal developer portfolio website showcasing projects, skills, and experience.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "fill-demo-data": "node src/database/fill-demo-data.js",
    "test": "cross-env LOG_LEVEL=error MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:50000/portfolio-webpage?retryWrites=false c8 --reporter html --reporter text-summary mocha --require tests/helpers/env-setup.js 'tests/**/*.test.js' --ignore 'tests/**/common.js' --ignore 'tests/helpers/**' --timeout 10000 --exit",
    "lint": "eslint . -f @microsoft/eslint-formatter-sarif -o results.sarif",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "portfolio",
    "webpage",
    "developer",
    "web-development"
  ],
  "author": "Kofler Phillip",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfi-OwO/portfolio-webpage.git",
    "directory": "application/server"
  },
  "homepage": "https://woofi-developments.at",
  "bugs": {
    "url": "https://github.com/Wolfi-OwO/portfolio-webpage/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "supertest": "^7.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "assert": "^2.1.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5"
  }
}
