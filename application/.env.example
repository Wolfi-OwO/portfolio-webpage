# Copy this file to .env and fill in real values. .env is gitignored.
# On the 0€ Oracle VM, keep the file on the docker host only (chmod 600) —
# docker compose interpolates these values at parse time, nothing reaches a
# container unless a service in docker-compose.prod.yaml lists it explicitly.

# ── Deployment: Oracle Cloud Always Free VM ─────────────────────────────────
# These are consumed by docker-compose.prod.yaml (and by `docker login` on
# the host, which both compose files never do themselves).

# Public domain the Caddy edge terminates TLS for and the site is served on.
DOMAIN=phillip-kofler.at

# Private Azure Container Registry the images are pulled from. ACR_SERVER
# defaults to portfolioacr.azurecr.io in compose, but the registry actually
# used on Azure runs a different name — set the real one here.
ACR_SERVER=

# ACR credentials for `docker login` ON THE HOST only. They live at the host
# level and are deliberately NOT passed into any container — the web/jobs
# services never need to touch the registry at runtime.
ACR_USERNAME=
ACR_PASSWORD=

# Which image tag to run. "latest" is the default; pin an IMAGE_TAG to a
# specific release for reproducible rollouts and rollbacks.
IMAGE_TAG=latest

# Azure AD service principal the jobs service uses to read the Container App
# control plane (in the Azure app that is checked via the Azure SDK's
# DefaultAzureCredential). Create it with a scoped role assignment
# (e.g. Reader on the monitored resource groups) and rotate its secret.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Resource groups whose Container Apps are monitored; comma-separated.
CONTAINER_APP_RESOURCE_GROUPS=portfolio-webpage-rg,netviz-rg,dsai-5bhif-app

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# MongoDB Atlas password for the `woofi` database user.
MONGODB_PASSWORD=

# Admin login username.
ADMIN_USER=admin

# Bcrypt hash of the admin password - never store the plaintext password.
# Generate with online tools
ADMIN_PASSWORD_HASH=

# Long, random secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# How long the secret page's download token stays valid. Defaults to 30m.
SECRET_EXPIRES_IN=30m

# How often (seconds) each monitored URL on the status page is checked. Defaults to 60.
STATUS_CHECK_INTERVAL_SECONDS=60

# ── Gift receipt download ────────────────────────────────────────────────────
# The receipt behind the secret page lives in a private blob container - it
# carries a home address and a card's last four digits, so it must never be
# anonymously readable. The server proxies the bytes; no SAS reaches the browser.
#
# In Azure this runs keyless: the container app's managed identity holds
# `Storage Blob Data Reader` on this one account, which is all it needs, so
# STORAGE_KEY is unset there and DefaultAzureCredential picks the identity up.
#
# Locally it is worth setting. DefaultAzureCredential tries EnvironmentCredential
# first, so the AZURE_CLIENT_ID/SECRET above win over your `az login` - and that
# service principal is a deployment identity with no role on this account, so the
# keyless path 403s until someone grants it one. A key sidesteps the whole chain.
# It is a full-access account key: it stays out of the client, and out of git.
STORAGE_ACCOUNT=globalutilsst01
STORAGE_KEY=
GIFT_CONTAINER=secret-gifts
GIFT_BLOB=voucher-receipt.pdf

# ── Activity heatmap ─────────────────────────────────────────────────────────
# These are read by the `syncContributions` timer in the monitor-checker Function
# App, which walks the full history once and then keeps it fresh. The web server
# itself never calls a forge — it only reads what the job wrote.
#
# GitHub: the contribution calendar only exists in the GraphQL API, and GraphQL
# requires a token even for public data. A classic PAT with NO scopes covers
# public contributions; add `read:user` (and `repo` for private repositories) to
# see everything. Without a token GitHub simply contributes nothing.
GITHUB_USER=Wolfi-OwO
GITHUB_TOKEN=

# GitLab: without a token only public projects are visible — which is why the old
# coursework (private) never showed up. A PAT with scope `read_api` makes the job
# see every project you are a member of. GITLAB_HOST can point at a self-hosted
# instance; the username is a variable because it is expected to change.
GITLAB_HOST=https://gitlab.com
GITLAB_USER=Koflerp
GITLAB_TOKEN=

# How often the sync runs (NCRONTAB, 6 fields — the leading field is seconds).
# Every minute by default; well inside the Functions free grant.
#
# Keep this name short. TruffleHog's GitLab detector matches any 20-22 character
# token-shaped string near the word "gitlab", and the old name (22 chars, sitting
# right under GITLAB_TOKEN) tripped the secret scan on every push.
CONTRIBUTIONS_CRON=0 * * * * *
# Repositories walked per tick during the one-time backfill. Keeps a single run
# short so it can never hit the execution timeout.
CONTRIBUTIONS_REPOS_PER_RUN=3
# How far back each incremental tick re-reads commits.
CONTRIBUTIONS_REFRESH_DAYS=21
# The backfill stops at this year.
CONTRIBUTIONS_EARLIEST_YEAR=2018

