# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas password for the `woofi` database user.
MONGODB_PASSWORD=

# Admin login username.
ADMIN_USER=admin

# Bcrypt hash of the admin password - never store the plaintext password.
# Generate with online tools
ADMIN_PASSWORD_HASH=

# Long, random secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# How often (seconds) each monitored URL on the status page is checked. Defaults to 60.
STATUS_CHECK_INTERVAL_SECONDS=60

# ── Activity heatmap ─────────────────────────────────────────────────────────
# These are read by the `syncContributions` timer in the monitor-checker Function
# App, which walks the full history once and then keeps it fresh. The web server
# itself never calls a forge — it only reads what the job wrote.
#
# GitHub: the contribution calendar only exists in the GraphQL API, and GraphQL
# requires a token even for public data. A classic PAT with NO scopes covers
# public contributions; add `read:user` (and `repo` for private repositories) to
# see everything. Without a token GitHub simply contributes nothing.
GITHUB_USER=Wolfi-OwO
GITHUB_TOKEN=

# GitLab: without a token only public projects are visible — which is why the old
# coursework (private) never showed up. A PAT with scope `read_api` makes the job
# see every project you are a member of. GITLAB_HOST can point at a self-hosted
# instance; the username is a variable because it is expected to change.
GITLAB_HOST=https://gitlab.com
GITLAB_USER=Koflerp
GITLAB_TOKEN=

# How often the sync runs (NCRONTAB, 6 fields — the leading field is seconds).
# Every minute by default; well inside the Functions free grant.
#
# Keep this name short. TruffleHog's GitLab detector matches any 20-22 character
# token-shaped string near the word "gitlab", and the old name (22 chars, sitting
# right under GITLAB_TOKEN) tripped the secret scan on every push.
CONTRIBUTIONS_CRON=0 * * * * *
# Repositories walked per tick during the one-time backfill. Keeps a single run
# short so it can never hit the execution timeout.
CONTRIBUTIONS_REPOS_PER_RUN=3
# How far back each incremental tick re-reads commits.
CONTRIBUTIONS_REFRESH_DAYS=21
# The backfill stops at this year.
CONTRIBUTIONS_EARLIEST_YEAR=2018

