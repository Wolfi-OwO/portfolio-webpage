# ═══════════════════════════════════════════════════════════════════════════
# Azure Functions (Node) runtime image for the monitor-checker Timer Trigger.
# Mirrors the Consumption plan the Function App runs on in Azure, so the exact
# same code + host.json runs identically locally under docker compose.
# ═══════════════════════════════════════════════════════════════════════════
FROM mcr.microsoft.com/azure-functions/node:4-node22

# The Functions host loads the app from /home/site/wwwroot and streams logs to
# stdout (so `docker compose logs monitor-checker` shows each check cycle).
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true \
    FUNCTIONS_WORKER_RUNTIME=node

WORKDIR /home/site/wwwroot

# Install production deps first for better layer caching — only re-runs when
# package*.json changes, not on every source edit.
COPY package*.json ./
RUN npm ci --omit=dev

# Function source + host configuration.
COPY host.json ./
COPY src ./src

# The base image's entrypoint starts the Functions host — no CMD needed.
