# ═══════════════════════════════════════════════════════════════════════════
# Azure Functions (Node) runtime image for the monitor-checker Timer Trigger.
# Mirrors the Consumption plan the Function App runs on in Azure, so the exact
# same code + host.json runs identically locally under docker compose.
# ═══════════════════════════════════════════════════════════════════════════
FROM mcr.microsoft.com/azure-functions/node:4-node22

# The Functions host loads the app from /home/site/wwwroot and streams logs to
# stdout (so `docker compose logs monitor-checker` shows each check cycle).
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true \
    FUNCTIONS_WORKER_RUNTIME=node

WORKDIR /home/site/wwwroot

# Debian publishes security fixes before the Functions base image is rebuilt, and the image scan fails the build on
# any HIGH finding that already has a fix (libpam-modules CVE-2025-6020 was the one that blocked every change). Taking
# the fixed packages here keeps the build from waiting on the upstream image.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# Install production deps first for better layer caching — only re-runs when
# package*.json changes, not on every source edit.
COPY package*.json ./
# The Functions host runs the worker with node directly, so npm is not needed once the dependencies are
# installed; the copy bundled in the base image carries unpatched dependencies.
RUN npm ci --omit=dev \
 && rm -rf /usr/lib/node_modules/npm /usr/lib/node_modules/corepack /usr/bin/npm /usr/bin/npx /usr/bin/corepack

# Function source + host configuration.
COPY host.json ./
COPY src ./src

# The base image's entrypoint starts the Functions host — no CMD needed.
